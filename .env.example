# copy to .env and fill in; never commit .env
ERCOT_USER=your-ercot-api-email
ERCOT_PASS=your-ercot-api-password
ERCOT_KEY=your-ercot-primary-key
# agent backend: ollama (local, default) or anthropic
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=            # only if LLM_PROVIDER=anthropic
